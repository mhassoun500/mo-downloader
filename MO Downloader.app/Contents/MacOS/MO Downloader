#!/bin/bash
# MO Downloader for macOS: starts the local server and opens it in the browser.
export PATH="/Library/Frameworks/Python.framework/Versions/Current/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
HERE="$(cd "$(dirname "$0")/../Resources" && pwd)"
LOG="$HOME/Library/Logs/MO Downloader.log"
mkdir -p "$HOME/Library/Logs"

PY=""
for c in python3.13 python3.12 python3.11 python3.10 python3; do
  p="$(command -v $c 2>/dev/null)" || continue
  # skip Apple's stub that only offers to install developer tools
  if [ "$p" = "/usr/bin/python3" ] && ! xcode-select -p >/dev/null 2>&1; then continue; fi
  PY="$p"; break
done
if [ -z "$PY" ]; then
  osascript -e 'display dialog "MO Downloader needs Python 3.\n\nDownload and install it from python.org, then open MO Downloader again." buttons {"Open python.org","Cancel"} default button 1 with title "MO Downloader" with icon caution' \
    -e 'if button returned of result is "Open python.org" then open location "https://www.python.org/downloads/macos/"' >/dev/null 2>&1
  exit 1
fi

# already open? let the app show its window (it checks ports 8765-8774 and answers the second launch itself)
export MO_APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"

# first run only: install what is missing. Opening is then immediate; the app itself keeps the engines
# current in the background, once a day (it no longer waits for pip at every start).
if ! "$PY" -c "import yt_dlp, gallery_dl, curl_cffi, imageio_ffmpeg, deno, webview" >/dev/null 2>&1; then
case " $* " in *" --background "*) ;; *) osascript -e 'display notification "Installing the download engine… (first launch only, about a minute)" with title "MO Downloader"' >/dev/null 2>&1;; esac
{
  echo "=== $(date) — $PY (first-run install)"
  "$PY" -m pip install -U --quiet --disable-pip-version-check "yt-dlp[default,curl-cffi]" gallery-dl imageio-ffmpeg deno pywebview 2>/dev/null \
   || "$PY" -m pip install -U --quiet --user "yt-dlp[default,curl-cffi]" gallery-dl imageio-ffmpeg deno pywebview 2>/dev/null \
   || "$PY" -m pip install -U --quiet --break-system-packages "yt-dlp[default,curl-cffi]" gallery-dl imageio-ffmpeg deno pywebview
} >>"$LOG" 2>&1
fi

"$PY" "$HERE/mo_downloader.py" "$@" >>"$LOG" 2>&1
code=$?
if [ $code -ne 0 ]; then
  osascript -e "display dialog \"MO Downloader could not start.\n\nDetails are in:\n$LOG\" buttons {\"OK\"} with title \"MO Downloader\" with icon stop" >/dev/null 2>&1
fi
exit $code
